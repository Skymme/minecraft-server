# Copier ce fichier en .env (jamais commité) puis remplir les valeurs.

# Mot de passe RCON (console distante + sauvegardes). Mets une longue chaîne aléatoire.
RCON_PASSWORD=change-moi

# Pseudos Minecraft autorisés, séparés par des virgules
WHITELIST=Pseudo1,Pseudo2,Pseudo3,Pseudo4
# Pseudos administrateurs
OPS=Pseudo1

# RAM allouée à la JVM (Oracle A1 24 Go : 10G-12G ; test local : 8G)
MEMORY=10G

# Version du pack ATM10 To the Sky (doit correspondre à celle des clients)
MODPACK_VERSION=2.0.6

# Optionnel : clé API CurseForge perso (entre apostrophes, elle contient des $)
# CF_API_KEY='$2a$10$...'

# Clé secrète de l'agent playit.gg (hébergement depuis un PC perso, profil "playit")
# PLAYIT_SECRET_KEY=

BACKUP_INTERVAL=6h
PRUNE_BACKUPS_DAYS=7
